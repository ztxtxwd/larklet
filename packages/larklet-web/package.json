{
  "name": "larklet-web",
  "version": "0.3.1",
  "description": "Larklet 机器人的配套网页框架：场景识别、免登鉴权、来源消息与当前会话。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "require": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./react": {
      "types": "./src/client/react.tsx",
      "import": "./src/client/react.tsx",
      "require": "./src/client/react.tsx",
      "default": "./src/client/react.tsx"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.9.6"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/larklet.git",
    "directory": "packages/larklet-web"
  },
  "publishConfig": {
    "access": "public"
  }
}
