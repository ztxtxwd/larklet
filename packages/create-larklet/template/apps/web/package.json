{
  "name": "@__APP_NAME__/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --watch --import tsx src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "larklet-web": "__LARKLET_WEB_SPEC__",
    "hono": "^4.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
